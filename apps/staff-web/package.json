{
  "name": "@eventor/staff-web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/harden-picomatch.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "vue": "3.5.45",
    "vue-i18n": "11.4.19",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.2",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vue-tsc": "3.1.4"
  }
}
