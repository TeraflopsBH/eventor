# Copy into the deployment's secret/configuration store. Do not commit real credentials.
# Use TLS with certificate and hostname verification in production.
EVENTOR_RUNTIME_DATABASE_URL=postgresql://eventor_runtime:REPLACE_ME@db.example.test:5432/eventor?sslmode=verify-full
EVENTOR_AUTH_DATABASE_URL=postgresql://eventor_auth:REPLACE_ME@db.example.test:5432/eventor?sslmode=verify-full
EVENTOR_WORKER_DATABASE_URL=postgresql://eventor_worker:REPLACE_ME@db.example.test:5432/eventor?sslmode=verify-full

# Base64-encoded, cryptographically random 32-byte keys; use separate values.
EVENTOR_FIELD_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
EVENTOR_CONTACT_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_BASE64_32_BYTE_KEY
EVENTOR_DELIVERY_CREDENTIALS_KEY=REPLACE_WITH_ANOTHER_DIFFERENT_BASE64_32_BYTE_KEY
EVENTOR_AUTH_FINGERPRINT_KEY=REPLACE_WITH_A_FOURTH_DIFFERENT_BASE64_32_BYTE_KEY

# Exact origins, comma separated. No wildcard origins are accepted.
EVENTOR_ALLOWED_ORIGINS=https://eventor.example.test

# Only when deployed behind a trusted reverse proxy; list exact proxy CIDRs.
# Leave empty when clients connect directly.
EVENTOR_TRUST_PROXY_CIDRS=

HOST=0.0.0.0
PORT=8080
EVENTOR_API_POOL_MAX=20
EVENTOR_AUTH_POOL_MAX=5
EVENTOR_WORKER_POOL_MAX=5
EVENTOR_WORKER_BATCH_SIZE=20
EVENTOR_WORKER_TENANT_LIMIT=100
EVENTOR_WORKER_IDLE_POLL_MS=3000
EVENTOR_WORKER_ERROR_POLL_MS=5000
